# Copy this file to .env and fill in the values.

# ---- AI provider ----
# Which AI runs the interview: claude | gemini | mock
#   mock   = no AI, no key needed (placeholder questions and scores, for testing the flow)
#   gemini = Google Gemini free tier, for realistic testing
#   claude = for launch
# If left empty, it picks automatically from whichever key below is filled in.
AI_PROVIDER=

# Free Gemini key for testing: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Claude key for launch: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# Server-side refusal fallback (routes a declined request to another model). Set to "off" to disable.
# CLAUDE_FALLBACKS=on

# ---- App ----
# Password for the HR dashboard at /admin
ADMIN_PASSWORD=change-me

# Shown in the page header
COMPANY_NAME=Careers

# Video interview settings
QUESTION_COUNT=6
MINUTES_PER_QUESTION=3
# Thinking time after each question is read aloud, before recording starts
PREP_SECONDS=20
