# Copy this file to .env and fill in the values. .env is ignored by git; this file is committed,
# so never put real keys, passwords or contact details here.
# Restart the app (npm run dev) after changing .env.

# ---- AI provider ----
# Which AI runs the interview is picked in this order (first match wins):
#   1. ANTHROPIC_API_KEY filled in  -> Claude (always wins; everything else below is ignored)
#   2. AI_PROVIDER set               -> gemini | hf | mock
#   3. GEMINI_API_KEY filled in      -> Gemini
#   4. HF_TOKEN filled in            -> Hugging Face
#   5. nothing                       -> mock (no AI; placeholder questions and scores)
# Leave AI_PROVIDER empty unless you have both a Gemini key and an HF token and want to choose one.
AI_PROVIDER=

# ---- Claude (for launch, top priority) ----
# https://console.anthropic.com -> API Keys -> Create Key
# While it still says PASTE, it is treated as empty.
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=on

# ---- Hugging Face (free credits, for testing) ----
# https://huggingface.co/settings/tokens -> Create new token -> "Fine-grained",
# tick "Make calls to Inference Providers" -> copy the token (starts with hf_)
HF_TOKEN=
# Chat model; must accept images (webcam snapshots are sent for proctoring notes).
# If you get "model not supported", pick another vision model on huggingface.co.
# HF_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Most webcam snapshots sent per grading request (the provider rejects more than 5).
# HF_MAX_IMAGES=5
# Whisper model, used when SPEECH_TO_TEXT (below) picks hf.
# HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# ---- Gemini (free tier, for testing) ----
# https://aistudio.google.com/apikey -> Create API key
# Optional. If filled in together with HF_TOKEN, Gemini is used unless AI_PROVIDER=hf.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ---- Speech-to-text (server) ----
# Before grading, each answer video is transcribed again on the server, which is more accurate than the browser's
# live transcript and lets candidates use browsers without speech recognition (Firefox).
# Works with any AI provider, Claude included (Claude can't hear audio, so this uses a separate key):
#   empty  -> automatic: Gemini if GEMINI_API_KEY is set, else Whisper if HF_TOKEN is set, else browser only
#   gemini | hf | off
# SPEECH_TO_TEXT=

# ---- Google (job application forms + sending email) ----
# Applicants apply through a Google Form made for each job. The app creates the forms in a Google account you connect
# from the dashboard (Jobs tab -> Connect Google), reads new responses every minute, and sends interview emails
# from that account's Gmail. Setup steps are in the README ("Google Forms setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FORM_POLL_SECONDS=60

# ---- Resume screening and interview invitations ----
# Applicants get an "application received" email at once. This many minutes after applying they get the decision:
# shortlisted (login + random password) or a rejection.
DECISION_DELAY_MINUTES=120
# Resumes the AI rates at or above this (0-100) are shortlisted. Each job can set its own in the dashboard.
RESUME_PASS_MARK=60
# Shortlisted applicants must start the interview within this many hours of the login email. Once started, they can finish.
INTERVIEW_ACCESS_HOURS=24
# Dates and times in emails are written in this time zone.
# TIME_ZONE=Asia/Kolkata
# Public address of the app: the login link in emails, and Google's return address when connecting.
# e.g. https://careers.yourcompany.com (for local testing: http://localhost:3000)
APP_URL=

# ---- Email through SMTP (optional) ----
# Without SMTP, emails go out from the connected Google account's Gmail, which is usually all you need.
# Set these to send from another mailbox instead, e.g. Zoho Mail: smtp.zoho.in, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to candidates, e.g. "Careers <careers@yourcompany.com>" (must be allowed by the SMTP account).
MAIL_FROM=
# Comma-separated staff addresses to tell when an interview has been graded (sent by Gmail or SMTP).
HR_NOTIFY_EMAILS=

# ---- Database (candidates, jobs, staff accounts) ----
# PostgreSQL connection string. Leave empty for local testing: records are then kept in JSON files in DATA_DIR.
# Free hosted options: Neon (neon.tech), Supabase (supabase.com), or a Railway Postgres service.
# Tables are created automatically on first start. To copy existing local data in: npm run migrate
DATABASE_URL=
# DATABASE_POOL_SIZE=10

# ---- File storage (resumes, answer videos, snapshots, screen recordings) ----
# Any S3-compatible bucket. Leave S3_BUCKET empty for local testing: files are then kept in DATA_DIR.
# Cloudflare R2 (10 GB free): Dashboard -> R2 -> Create bucket; then "Manage API tokens" -> Create token
#   (Object Read & Write) -> copy the Access Key ID, Secret Access Key and the S3 endpoint below.
# The bucket must stay PRIVATE: the app streams files to signed-in staff itself.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; the bucket's region (e.g. ap-south-1) for AWS S3.
S3_REGION=auto
# Needed by some providers (MinIO, some self-hosted); not for R2 or AWS.
# S3_FORCE_PATH_STYLE=true

# ---- App ----
# Answer videos, snapshots and screen recordings are deleted this many days after the interview ends.
# Resumes, transcripts, scores and the proctoring timeline are kept. 0 = keep forever.
MEDIA_RETENTION_DAYS=15

# Signs login sessions and encrypts the saved Google connection. Set it once and don't change it (changing it signs
# everyone out and means reconnecting Google). A long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Staff accounts that stay deactivated this many days are deleted automatically.
ACCOUNT_DELETE_AFTER_DAYS=15
# Backend console logs: debug | info | warn | error (default info).
# LOG_LEVEL=info
# Where candidates, jobs, resumes and videos are stored. On Railway, point this at the mounted volume.
# DATA_DIR=data

# Shown in the page header
COMPANY_NAME=Galaxy Toyota

# Shown to candidates whose interview was interrupted, so they can ask for a re-interview
HR_CONTACT=hr@yourcompany.com or +91 98xxxxxxxx

# ---- Video interview ----
QUESTION_COUNT=6
MINUTES_PER_QUESTION=3
# Thinking time after the question is read out, before recording starts.
PREP_SECONDS=5
# An in-progress interview with no heartbeat for this long is auto-submitted as interrupted.
# HEARTBEAT_TIMEOUT_SECONDS=90

# Leaving the tab or exiting fullscreen during the interview:
# the first MAX_WARNINGS times are warnings; the next time, or staying away longer than
# AWAY_GRACE_SECONDS, submits the interview and tells the candidate to contact HR.
MAX_WARNINGS=2
AWAY_GRACE_SECONDS=10

# Camera rules during the interview:
# looking away from the screen: MAX_LOOK_AWAY_WARNINGS warnings, then the next time ends it.
# another person on camera: one warning with a SECOND_PERSON_GRACE_SECONDS countdown
# (ends it if they're still there at 0); a second appearance ends it immediately.
MAX_LOOK_AWAY_WARNINGS=2
SECOND_PERSON_GRACE_SECONDS=5
