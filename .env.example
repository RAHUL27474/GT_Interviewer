# Copy this file to .env and fill in the values. .env is ignored by git; this file is committed,
# so never put real keys, passwords or contact details here.
# Restart the app (npm run dev) after changing .env.

# ---- AI provider ----
# Which AI runs the interview is picked in this order (first match wins):
#   1. ANTHROPIC_API_KEY filled in  -> Claude (always wins; everything else below is ignored)
#   2. AI_PROVIDER set               -> gemini | hf | mock
#   3. GEMINI_API_KEY filled in      -> Gemini
#   4. HF_TOKEN filled in            -> Hugging Face (+ Whisper speech-to-text)
#   5. nothing                       -> mock (no AI; placeholder questions and scores)
# Leave AI_PROVIDER empty unless you have both a Gemini key and an HF token and want to choose one.
AI_PROVIDER=

# ---- Claude (for launch, top priority) ----
# https://console.anthropic.com -> API Keys -> Create Key
# While it still says PASTE, it is treated as empty.
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=on

# ---- Hugging Face (free credits, for testing) ----
# https://huggingface.co/settings/tokens -> Create new token -> "Fine-grained",
# tick "Make calls to Inference Providers" -> copy the token (starts with hf_)
HF_TOKEN=
# Chat model; must accept images (webcam snapshots are sent for proctoring notes).
# If you get "model not supported", pick another vision model on huggingface.co.
# HF_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Most webcam snapshots sent per grading request (the provider rejects more than 5).
# HF_MAX_IMAGES=5
# Speech-to-text: re-transcribes each answer video with Whisper before grading.
# "off" keeps only the browser transcript (saves free credits).
# HF_WHISPER=on
# HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# ---- Gemini (free tier, for testing) ----
# https://aistudio.google.com/apikey -> Create API key
# Optional. If filled in together with HF_TOKEN, Gemini is used unless AI_PROVIDER=hf.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ---- App ----
# Dashboard sign-in (/admin). The first account, a Super Admin, is created from these two values
# on a fresh install; after that, the Super Admin adds Managers and HR under "Team".
SUPER_ADMIN_EMAIL=superadmin@company.com
ADMIN_PASSWORD=change-me
# Signs login sessions. Set a long random value in production, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Staff accounts that stay deactivated this many days are deleted automatically.
ACCOUNT_DELETE_AFTER_DAYS=15
# Backend console logs: debug | info | warn | error (default info).
# LOG_LEVEL=info
# Where candidates, jobs, resumes and videos are stored. On Railway, point this at the mounted volume.
# DATA_DIR=data

# Shown in the page header
COMPANY_NAME=Your Company

# Shown to candidates whose interview was interrupted, so they can ask for a re-interview
HR_CONTACT=hr@yourcompany.com or +91 98xxxxxxxx

# ---- Video interview ----
QUESTION_COUNT=6
MINUTES_PER_QUESTION=3
# Thinking time after the question is read out, before recording starts.
PREP_SECONDS=5
# An in-progress interview with no heartbeat for this long is auto-submitted as interrupted.
# HEARTBEAT_TIMEOUT_SECONDS=90

# Leaving the tab or exiting fullscreen during the interview:
# the first MAX_WARNINGS times are warnings; the next time, or staying away longer than
# AWAY_GRACE_SECONDS, submits the interview and tells the candidate to contact HR.
MAX_WARNINGS=2
AWAY_GRACE_SECONDS=10

# Camera rules during the interview:
# looking away from the screen: MAX_LOOK_AWAY_WARNINGS warnings, then the next time ends it.
# another person on camera: one warning with a SECOND_PERSON_GRACE_SECONDS countdown
# (ends it if they're still there at 0); a second appearance ends it immediately.
MAX_LOOK_AWAY_WARNINGS=2
SECOND_PERSON_GRACE_SECONDS=5
