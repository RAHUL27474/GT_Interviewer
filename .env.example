# Copy this file to .env and fill in the values.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Password for the HR dashboard at /admin
ADMIN_PASSWORD=change-me

# Shown in the page header
COMPANY_NAME=Careers

# Video interview settings
QUESTION_COUNT=6
MINUTES_PER_QUESTION=3
# Thinking time after each question is read aloud, before recording starts
PREP_SECONDS=20

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# Server-side refusal fallback (routes a declined request to another model). Set to "off" to disable.
# CLAUDE_FALLBACKS=on
