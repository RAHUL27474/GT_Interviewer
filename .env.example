# Local secrets. Git ignores this file, so it never goes to GitHub.

# ---- AI provider ----
# Which AI runs the interview: groq | claude | gemini | mock
#   mock   = no AI, no key needed (placeholder questions and scores, for testing the flow)
#   groq   = fast Groq-hosted model
#   gemini = Google Gemini free tier, for realistic testing
#   claude = Anthropic
# If left empty, it picks automatically from whichever key below is filled in.
AI_PROVIDER=groq

# Free Gemini key for testing: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=gsk-REPLACE-WITH-YOUR-GROQ-KEY
# Must support Structured Outputs (response_format: json_schema).
#
# openai/gpt-oss-120b is the default for a reason. Groq documents only
# openai/gpt-oss-20b and openai/gpt-oss-120b as supporting strict: true, which is
# constrained decoding and so guarantees the response matches the schema. Every
# other structured-output model is best-effort and can return HTTP 400.
#
# 120b rather than 20b: asked for six interview questions, 20b returned one.
#
# Avoid qwen/qwen3.8-27b here. It supports json_schema on a best-effort basis only,
# and in practice it rejected the real question-generation request two ways: a 400
# "Failed to validate JSON", and a 429 "Request too large" once a full resume and job
# description were attached. gpt-oss-120b returns all six questions in one call.
GROQ_MODEL=openai/gpt-oss-120b

# Claude, the fallback provider. Only needed if you want claude selected
# explicitly, or as a fallback when Groq is rate-limited: set CLAUDE_FALLBACKS to
# off to make a Claude failure a hard error instead of a silent second attempt.
# This mirrors the default in lib/config.ts. claude-sonnet-5 is markedly cheaper
# and is the better pick if you are generating interview questions all day.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_FALLBACKS=on

# ---- Voice gateway (server-only; never expose this key to the browser) ----
VOICE_GATEWAY_URL=http://127.0.0.1:8000
VOICE_GATEWAY_API_KEY=
# Prefer an understanding model here (mock, qwen-omni, or moshi). Higgs v2 is a TTS stage.
VOICE_GATEWAY_MODEL=mock
VOICE_GATEWAY_TTS_MODEL=
VOICE_GATEWAY_TIMEOUT_MS=90000

# ---- App ----
# Password for the HR dashboard at /admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Shown in the page header
COMPANY_NAME=Galaxy Toyota

# Shown to candidates whose interview was interrupted, so they can ask for a re-interview
HR_CONTACT=hr@example.com or +91 0000000000

# Video interview settings
QUESTION_COUNT=6
MINUTES_PER_QUESTION=3
PREP_SECONDS=20

# A tab that goes hidden or leaves fullscreen is a proctoring signal. Leaving
# for longer than this ends the interview; each incident adds a warning, and the
# candidate is warned once past MAX_WARNINGS.
AWAY_GRACE_SECONDS=10
MAX_WARNINGS=2

# An interview with no heartbeat for this long is auto-submitted as interrupted,
# so a closed laptop or a dropped connection does not strand the candidate in
# "in progress" forever. Minimum 10.
HEARTBEAT_TIMEOUT_SECONDS=90

# ---- Round 1 resume screening ----
# The screening model lives in ../src/resume_screening (Python, sentence-transformers
# all-MiniLM-L6-v2 + an explainable skill-coverage score). It runs as a resident
# bridge process so the model loads once instead of per candidate.
#
# It needs the parent project's virtualenv:
#   cd ..            # the Resume-Screening repo root
#   uv sync
# The first run downloads the model from Hugging Face (~90 MB), then it is cached.
#
# If the bridge cannot start, the app logs a warning and falls back to the LLM
# judge in lib/ai, so screening still works with no Python at all. Set this to
# false to always use the LLM.
SCREENING_BRIDGE_ENABLED=true
# Auto-detected from ../.venv, then whatever python is on PATH. Set explicitly if
# the interpreter lives somewhere else, e.g. SCREENING_BRIDGE_PYTHON=C:\Python312\python.exe
SCREENING_BRIDGE_PYTHON=
# Generous, because the first call after a restart pays the model load.
SCREENING_BRIDGE_TIMEOUT_MS=120000

# Resumes screened at once by the worker. Each concurrent job holds the bridge,
# which holds one embedding model, so this is capped at 16: past that you trade
# throughput for the worker being OOM-killed mid-batch.
SCREENING_WORKER_CONCURRENCY=2

# Auto-advance to the AI interview at or above this score (0-100; default 75).
# Between the two marks a resume waits for a person. Below the review floor it is
# still never auto-rejected: the candidate lands in the HR queue with the full
# breakdown, and HR decides. Mock AI mode never auto-advances.
#
# The upstream Python default is 90, but its own docs note that cosine similarity
# for genuinely related professional text lands around 0.6-0.75, which rescales to
# roughly 80-88. A 90 cut-off would reject effectively every real candidate, so 75
# is the default here. Raise it only if you see good candidates being let through.
RESUME_SCREEN_PASS_SCORE=75
RESUME_SCREEN_REVIEW_SCORE=50

# ---- Candidate notifications ----
# Everything is off until NOTIFY_EMAIL_PROVIDER is set to a supported value, so a
# fresh checkout sends nothing and cannot fail a registration.
#
# Three messages are sent:
#   application_received - to the candidate, right after they apply. Neutral: no
#                          score, no verdict, no promise about the outcome.
#   interview_ready      - to the candidate, once the interview is actually live
#                          (so the link in it works).
#   awaiting_hr_review   - to HR, when a candidate needs a decision.
#
# Nothing is ever sent to reject a candidate: HR reviews every applicant, so a
# not-shortlisted candidate only ever receives the acknowledgement. Every attempt
# is recorded on the candidate and shown in the admin drawer, so a failed send is
# visible and can be followed up by hand.
#
# A mail failure never fails screening or registration.
#
# resend | sendgrid
NOTIFY_EMAIL_PROVIDER=none
# API key for the chosen provider.
NOTIFY_EMAIL_API_KEY=
# Absolute origin used to build the interview link. Must be reachable by the
# candidate, not localhost, or the link they receive will not open.
APP_URL=http://localhost:3000
# Verified sender. Both providers reject anything they cannot verify, and a
# misconfigured sender silently loses every mail rather than erroring loudly.
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=Hiring Team
# Where "a resume needs review" alerts go. Falls back to NOTIFY_FROM_EMAIL.
NOTIFY_HR_EMAIL=

# ---- Careers page and job boards ----
# The careers page reads the same job records as the application form, so it is
# a second view of data/jobs.json rather than a separate CMS. It works on its
# own: every role emits schema.org/JobPosting JSON-LD (Google for Jobs) and there
# are RSS and JSON feeds at /careers/feed.xml and /careers/jobs.json.
#
# Required in production. Every URL in the structured data and the feeds is
# absolute, and Google discards a posting whose url is relative, so leaving this
# at localhost produces valid output that is never indexed.
SITE_URL=https://apply.example.com
CAREERS_EMAIL=careers@example.com
# Days a role stays listed after it is posted. Recruitee caps premium jobs at 90.
JOB_POSTING_VALID_DAYS=60

# Where active jobs get pushed. "none" keeps everything on our own careers page.
#
# Naukri is deliberately not an option: it has no posting API, and driving its
# recruiter UI with a browser breaks their terms and risks a permanent ban on
# the employer's own account. LinkedIn's Job Posting API is closed to new
# partners. Add an adapter in lib/publishers/ if another board opens up.
JOB_PUBLISHER=none

# Dry run reports the exact API calls it would make and writes nothing. It
# defaults to true so a half-finished token below cannot publish a real board by
# accident. Trigger it from the admin panel, or:
#   POST /api/admin/jobs/publish?dryRun=true
# Read the output first, then set this to false and run it again.
JOB_PUBLISH_DRY_RUN=true

# Recruitee. Create a Personal API token in Recruitee at
# Settings > Apps and plugins > API Tokens. It carries the full permissions of
# your user and cannot be scoped down, so it is server-side only: nothing here is
# reachable from the browser and the only entry point is the admin route.
#
# The Careers Site token does NOT work for this. It is read-only and the first
# POST /offers fails with a 401/403.
RECRUITE_COMPANY_ID=
RECRUITE_API_TOKEN=
# Used only when a job's location text matches none of the locations configured
# in your Recruitee account. Recruitee requires a location id on every offer.
RECRUITE_LOCATION_ID=
# Point at https://api.rc.recruitee.com to rehearse against their
# release-candidate environment before touching production.
RECRUITE_API_BASE=https://api.recruitee.com
# Pause between Recruitee calls. Trial accounts are capped at 5 requests/minute.
RECRUITE_REQUEST_DELAY_MS=250

# Ceiling on a single publish request. A job with many locations can take a while
# to sync, and a publish that hangs forever leaves the admin panel spinning.
JOB_PUBLISH_TIMEOUT_MS=20000

# ------------------------------------------------- Shortlisted-candidate invite

# How long a shortlisted candidate has to finish their interview, shown as
# "Last date to complete" on the invitation. 48 hours spans a weekend without
# the invitation expiring before anyone has had a working day to see it.
INTERVIEW_INVITE_DEADLINE_HOURS=48

# How many focus areas to name on the invitation and the brief. Four is what
# fits without turning into a wall of text; more would just restate the JD.
INTERVIEW_TOPICS_MAX=4

# Local Compose values; replace with managed service URLs and credentials in production.
DATABASE_URL=postgresql://gt_interviewer:local-development-only@localhost:5432/gt_interviewer
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=gt-interviewer
OBJECT_STORAGE_REGION=us-east-1
# Set this for S3-compatible storage such as local MinIO; omit for AWS S3.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=interviewer
OBJECT_STORAGE_SECRET_KEY=local-development-only
