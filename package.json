{
  "name": "dt-ai-interviewer",
  "version": "1.0.0",
  "private": true,
  "description": "AI screening interviewer: candidate registration, JD-based AI interview, and weighted scoring.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-db.ts",
    "db:import-json": "node --env-file-if-exists=.env --import tsx scripts/import-json.ts",
    "screening:worker": "node --env-file-if-exists=.env --import tsx scripts/screening-worker.ts",
    "test": "npm run typecheck && node --import tsx scripts/run-tests.ts",
    "postinstall": "node scripts/copy-mediapipe.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@google/genai": "^2.24.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "bullmq": "^6.3.8",
    "mammoth": "^1.12.3",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
